{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "audience": {
            "type": "string"
        },
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cleanupInterval": {
            "type": "string"
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "credentialOrigin": {
            "type": "string"
        },
        "existingSecret": {
            "type": "string"
        },
        "externalDNSIP": {
            "type": "string"
        },
        "gatewayAPI": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "parentRefs": {
                    "type": "array"
                }
            }
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts and the platform.",
            "additionalProperties": true,
            "properties": {
                "podSecurityStandards": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "helm": {
            "type": "object",
            "additionalProperties": true
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "registry": {
                    "type": "string"
                },
                "repository": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "ingress": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "className": {
                    "type": "string"
                },
                "enabled": {
                    "type": "boolean"
                },
                "portalTlsSecretName": {
                    "type": "string"
                },
                "tlsSecretName": {
                    "type": "string"
                }
            }
        },
        "installation": {
            "type": "string"
        },
        "managementCluster": {
            "type": "string"
        },
        "managers": {
            "type": "object",
            "additionalProperties": false
        },
        "oauth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "caSecretName": {
                    "type": "string"
                },
                "clientId": {
                    "type": "string"
                },
                "issuer": {
                    "type": "string"
                },
                "kubernetesAudience": {
                    "type": "string"
                }
            }
        },
        "operationCapacity": {
            "type": "integer"
        },
        "platformNamespace": {
            "type": "string"
        },
        "portalOrigin": {
            "type": "string"
        },
        "provider": {
            "type": "string"
        },
        "replicas": {
            "type": "integer"
        },
        "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        },
        "tenancy": {
            "type": "boolean"
        }
    }
}
